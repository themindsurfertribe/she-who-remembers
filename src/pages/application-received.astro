---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import SiteCta from '../components/SiteCta.astro';
import { withBase } from '../data/site';
---

<BaseLayout
  title="Application Received | She Who Remembers"
  description="This page is reserved for future application-based offerings. It is not used by the current contact form."
  robots="noindex, nofollow"
>
  <Section surface="light">
    <Container width="narrow">
      <h1>Application received</h1>
      <p>
        This page is kept for future application-based offerings. The current contact form does
        not submit here, and nothing on this page confirms that an application was processed.
      </p>
      <p>
        If you meant to send a general message, use Contact. If you meant to schedule a fit
        conversation, use Book a Conversation.
      </p>
    </Container>
  </Section>
  <SiteCta
    heading="Choose the door you actually need"
    primary={{ label: 'Contact', href: withBase('/contact') }}
    secondary={{ label: 'Book a Conversation', href: withBase('/book-a-conversation') }}
  >
    <p>This route is idle until an application form exists.</p>
  </SiteCta>
</BaseLayout>
