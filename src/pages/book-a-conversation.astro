---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Button from '../components/Button.astro';
import SiteCta from '../components/SiteCta.astro';
import TextLink from '../components/TextLink.astro';
import { withBase } from '../data/site';
import {
  bookingProviderName,
  hasContactFormEndpoint,
  hasPublicCalUrl,
  publicCalUrl,
} from '../data/integrations';

const provider = hasPublicCalUrl ? bookingProviderName(publicCalUrl) : '';
---

<BaseLayout
  title="Book a Conversation | She Who Remembers"
  description="A short fit conversation to locate your threshold and see whether a course, private guidance, or another path is the honest next step."
>
  <Hero
    heading="Book a Conversation"
    lede="This is not a sales ambush. It is a short fit conversation."
    surface="light"
    spacing="compact"
  >
    <p>
      The point is to understand where you are, what you are looking for, and whether a course,
      private guidance, or another path makes sense. It is also to notice when this work is not
      the right room.
    </p>
  </Hero>

  <Section surface="light">
    <Container width="narrow">
      <SectionIntro heading="What this conversation is for">
        <p>Orientation. Not a closing technique.</p>
      </SectionIntro>
      <ul class="fit">
        <li>Locating the threshold you are actually standing on.</li>
        <li>Clarifying what kind of support, if any, may fit.</li>
        <li>Asking practical questions about the work.</li>
        <li>Checking alignment, including values and pace.</li>
        <li>Naming when another kind of support would be more appropriate.</li>
      </ul>
    </Container>
  </Section>

  <Section surface="light" spacing="compact">
    <Container width="narrow">
      <SectionIntro heading="What it is not">
        <p>The edges keep the conversation honest.</p>
      </SectionIntro>
      <ul class="not">
        <li>Not a therapy session, diagnosis, or crisis support.</li>
        <li>Not pressure to buy, enroll, or decide on the call.</li>
        <li>Not a promise that there will be a fit.</li>
        <li>Not a place where you must disclose everything before trust exists.</li>
      </ul>
    </Container>
  </Section>

  <Section surface="light">
    <Container width="narrow">
      <SectionIntro heading="Before you book">
        <p>Simple expectations. No invented cancellation terms.</p>
      </SectionIntro>
      <ul class="fit">
        <li>Choose a time you can actually protect.</li>
        <li>Arrive with the real question, even if it is not polished.</li>
        <li>You do not need a perfect story, a résumé of suffering, or a prepared pitch.</li>
        <li>If you need to reschedule, do so through the booking calendar. A fuller policy will be published when it is ready.</li>
      </ul>
    </Container>
  </Section>

  <Section surface="light" spacing="compact" id="schedule">
    <Container width="narrow">
      <SectionIntro heading="Choose a time">
        {
          hasPublicCalUrl ? (
            <p>Scheduling happens off this site, on an external booking calendar.</p>
          ) : (
            <p>A time can be chosen here once scheduling is connected.</p>
          )
        }
      </SectionIntro>
      {
        hasPublicCalUrl ? (
          <div class="booking">
            <Button
              href={publicCalUrl}
              target="_blank"
              rel="noopener noreferrer"
              ariaDescribedBy="booking-note"
            >
              Choose a Time
            </Button>
            <p class="booking__note" id="booking-note">
              Opens {provider} in a new tab. This website does not process the appointment. Any
              confirmation email would come from that calendar, not from this page.
            </p>
          </div>
        ) : (
          <p class="preview-note" id="booking-status" role="status">
            Online scheduling is not active on this preview yet. When scheduling is connected,
            available times will appear here.
          </p>
        )
      }
      <p class="alt">
        {
          hasContactFormEndpoint ? (
            <>
              If you need a practical message rather than a conversation, use{' '}
              <TextLink href={withBase('/contact')}>Contact</TextLink>.
            </>
          ) : (
            <>
              For general messages, Contact is the right route once message submission is active.
            </>
          )
        }
      </p>
    </Container>
  </Section>

  <SiteCta
    heading="Not sure this is the right door?"
    primary={{ label: 'Begin Here', href: withBase('/begin-here') }}
    secondary={{ label: 'Explore the Work', href: withBase('/the-work') }}
  >
    <p>
      {
        hasPublicCalUrl
          ? 'You can locate yourself first. The calendar will still be there.'
          : 'You can locate yourself first. Scheduling will be available once this preview is connected.'
      }
    </p>
  </SiteCta>
</BaseLayout>

<style>
  .fit,
  .not {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }

  .fit li,
  .not li {
    position: relative;
    margin: 0 0 var(--space-sm);
    padding-left: 1.15rem;
  }

  .fit li:last-child,
  .not li:last-child {
    margin-bottom: 0;
  }

  .fit li::before,
  .not li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.4rem;
    height: 0.4rem;
    border: var(--border-width) solid var(--border-accent);
    border-radius: 50%;
  }

  .booking {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .booking__note,
  .alt,
  .preview-note {
    margin: var(--space-md) 0 0;
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .preview-note {
    margin-top: 0;
  }
</style>
