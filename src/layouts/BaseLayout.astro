---
import { existsSync } from 'node:fs';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteName, withBase } from '../data/site';
import { appleTouchIconPath, defaultOgImagePath } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title = 'She Who Remembers',
  description = 'A body of work for women in transition: remembering sovereignty, self-trust, and the life that still belongs to you.',
  robots,
  canonical,
  ogImage,
  ogType = 'website',
  showHeader = true,
  showFooter = true,
} = Astro.props;

const site = Astro.site;
const faviconHref = withBase('/favicon.svg');
const hasDefaultOg = existsSync('public/images/social/og-default.png');
const hasAppleIcon = existsSync('public/favicon/apple-touch-icon.png');

const canonicalHref = site
  ? new URL(canonical ?? Astro.url.pathname, site).href
  : undefined;

const ogSource = ogImage ?? (hasDefaultOg ? defaultOgImagePath : undefined);
const ogImageHref = ogSource && site ? new URL(withBase(ogSource), site).href : undefined;

const websiteUrl = site ? new URL(import.meta.env.BASE_URL || '/', site).href : undefined;
const websiteJson = websiteUrl
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: websiteUrl,
    })
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    {hasAppleIcon && <link rel="apple-touch-icon" href={withBase(appleTouchIconPath)} />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    {ogImageHref && <meta property="og:image" content={ogImageHref} />}
    <meta name="twitter:card" content={ogImageHref ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageHref && <meta name="twitter:image" content={ogImageHref} />}
    {websiteJson && <script type="application/ld+json" set:html={websiteJson} />}
    <!--
      Webfonts from Google Fonts (https://fonts.google.com):
      Cinzel Display (headings), Lora (body), Montserrat (UI).
      Families are applied only through CSS tokens in src/styles/tokens.css.
      Privacy implication: Google may receive technical information such as IP address.
      Self-hosting remains a later option. Do not download font files unless approved.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Display:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-surface="light">
    <a class="skip-link" href="#main">Skip to content</a>
    {showHeader && <Header />}
    <main id="main">
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>
