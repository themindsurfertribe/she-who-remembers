---
import EmblemPlaceholder from './EmblemPlaceholder.astro';
import { siteName, withBase } from '../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const home = withBase('/');
---

<a class:list={['lockup', className]} href={home}>
  <span class="lockup__mark">
    <slot name="mark">
      <EmblemPlaceholder size="xs" decorative />
    </slot>
  </span>
  <span class="lockup__wordmark">{siteName}</span>
</a>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    color: var(--text);
    text-decoration: none;
  }

  .lockup:hover {
    color: var(--text);
  }

  .lockup__mark {
    display: grid;
    flex: 0 0 auto;
    color: var(--border-accent);
  }

  .lockup__mark :global(.emblem) {
    width: 2rem;
    height: 2rem;
  }

  .lockup__mark :global(svg) {
    width: 2rem;
    height: 2rem;
  }

  .lockup__wordmark {
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 0.4vw + 0.68rem, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: var(--leading-tight);
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 359px) {
    .lockup__mark {
      display: none;
    }
  }
</style>
