---
interface Props {
  question: string;
  class?: string;
}

const { question, class: className } = Astro.props;
---

<details class:list={['faq', className]}>
  <summary class="faq__summary">
    <span class="faq__question">{question}</span>
    <span class="faq__toggle" aria-hidden="true"></span>
  </summary>
  <div class="faq__answer">
    <slot />
  </div>
</details>

<style>
  .faq {
    border-bottom: var(--border-width) solid var(--gold-border);
  }

  .faq__summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    cursor: pointer;
    list-style: none;
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 500;
    line-height: var(--leading-heading);
  }

  .faq__summary::-webkit-details-marker,
  .faq__summary::marker {
    display: none;
    content: "";
  }

  .faq__question {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .faq__toggle {
    flex: none;
    width: 1.25rem;
    color: var(--border-accent);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
  }

  .faq__toggle::before {
    content: "+";
  }

  .faq[open] .faq__toggle::before {
    content: "\2212";
  }

  .faq__answer {
    padding-bottom: var(--space-md);
    color: var(--text-muted);
  }

  .faq[open] .faq__answer {
    padding-top: var(--space-2xs);
  }

  .faq__answer :global(p) {
    color: var(--text-muted);
  }

  .faq__answer :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
