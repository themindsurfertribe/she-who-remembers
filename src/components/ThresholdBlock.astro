---
import TextLink from './TextLink.astro';

interface Pathway {
  label: string;
  href: string;
}

interface Props {
  number: string;
  quote: string;
  pathways: Pathway[];
  class?: string;
}

const { number, quote, pathways, class: className } = Astro.props;
---

<article class:list={['threshold', className]}>
  <p class="threshold__number">{number}</p>
  <h2 class="threshold__quote">{quote}</h2>
  <div class="threshold__body">
    <slot />
  </div>
  <p class="threshold__paths">
    <span class="threshold__paths-label">A door from here:</span>
    {
      pathways.map((item, index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          <TextLink href={item.href}>{item.label}</TextLink>
        </>
      ))
    }
  </p>
</article>

<style>
  .threshold {
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }

  .threshold__number {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .threshold__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }

  .threshold__body {
    color: var(--text);
  }

  .threshold__paths {
    margin: var(--space-xs) 0 0;
    max-width: none;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
  }

  .threshold__paths-label {
    display: block;
    margin-bottom: var(--space-2xs);
    color: var(--text-muted);
  }
</style>
