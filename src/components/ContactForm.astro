---
import Button from './Button.astro';
import {
  absoluteSiteUrl,
  hasContactFormEndpoint,
  hasPublicCalUrl,
  publicContactFormEndpoint,
} from '../data/integrations';

const thankYouUrl = absoluteSiteUrl('/thank-you');
const connected = hasContactFormEndpoint;
---

{
  connected ? (
    <form class="contact-form" method="post" action={publicContactFormEndpoint} accept-charset="UTF-8">
      <input type="hidden" name="_next" value={thankYouUrl} />
      <input type="hidden" name="redirect" value={thankYouUrl} />
      <input type="hidden" name="_subject" value="She Who Remembers contact form" />

      <div class="honeypot" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field">
        <label for="contact-name">
          Name <span class="req">(required)</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="120"
        />
      </div>

      <div class="field">
        <label for="contact-email">
          Email <span class="req">(required)</span>
        </label>
        <p class="field-hint" id="email-hint">Used only if a reply is appropriate.</p>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          maxlength="120"
          aria-describedby="email-hint"
        />
      </div>

      <div class="field">
        <label for="contact-reason">
          Reason for writing <span class="req">(required)</span>
        </label>
        <select id="contact-reason" name="reason" required>
          <option value="">Choose one</option>
          <option value="General question">General question</option>
          <option value="Courses">Courses</option>
          <option value="Private Guidance">Private Guidance</option>
          <option value="Book">Book</option>
          <option value="Collaboration / Speaking">Collaboration / Speaking</option>
          <option value="Website issue">Website issue</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="field">
        <label for="contact-message">
          Message <span class="req">(required)</span>
        </label>
        <p class="field-hint" id="message-hint">
          Practical questions only. Do not include confidential medical, psychiatric, legal, or
          crisis information.
        </p>
        <textarea
          id="contact-message"
          name="message"
          required
          maxlength="4000"
          aria-describedby="message-hint"
        />
      </div>

      <p class="privacy-note">
        Do not submit confidential medical, psychiatric, legal, or crisis information through this
        form.
        {
          hasPublicCalUrl
            ? ' For coaching fit, use Book a Conversation instead.'
            : ' For coaching fit, Book a Conversation is the right route once scheduling is active.'
        }
      </p>

      <Button type="submit">Send message</Button>
    </form>
  ) : (
    <div class="contact-form contact-form--preview">
      <p class="preview-note" id="contact-status" role="status">
        Message submission is not active on this preview yet. The form will be available here
        once contact delivery is connected.
      </p>
      <fieldset disabled aria-describedby="contact-status">
        <legend class="visually-hidden">Message form, not currently available</legend>
        <div class="field">
          <label for="contact-name-off">Name (required)</label>
          <input id="contact-name-off" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="contact-email-off">Email (required)</label>
          <input id="contact-email-off" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="contact-reason-off">Reason for writing (required)</label>
          <select id="contact-reason-off">
            <option>Choose one</option>
          </select>
        </div>
        <div class="field">
          <label for="contact-message-off">Message (required)</label>
          <textarea id="contact-message-off" />
        </div>
        <Button type="submit" disabled ariaDescribedBy="contact-status">Send message</Button>
        <p class="preview-note preview-note--inline">Sending is not available yet.</p>
      </fieldset>
    </div>
  )
}

<style>
  .contact-form {
    max-width: 32rem;
  }

  .field {
    margin: 0 0 var(--space-md);
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .req {
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--text-muted);
  }

  .privacy-note,
  .preview-note {
    margin: 0 0 var(--space-md);
    max-width: none;
    color: var(--text-muted);
    font-size: var(--text-caption);
  }

  .preview-note {
    font-size: var(--text-body);
  }

  .preview-note--inline {
    margin-top: var(--space-sm);
    font-size: var(--text-caption);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  fieldset:disabled {
    opacity: 0.78;
  }

  fieldset:disabled input,
  fieldset:disabled textarea,
  fieldset:disabled select,
  fieldset:disabled button {
    cursor: not-allowed;
  }
</style>
