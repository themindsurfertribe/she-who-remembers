# Copy this file to .env and fill in local values.
# Never commit a real .env file.

# PUBLIC_ variables are exposed to the browser in Astro.
# Use them only for values that are safe to publish
# (site URL, public booking link, public Stripe checkout/page URL).
# Private server-side secrets must never use the PUBLIC_ prefix
# and must never be committed to Git.

# Canonical production URL, including protocol. Used by Astro `site`.
PUBLIC_SITE_URL=

# GitHub Pages project path. Leave empty or "/" for a custom domain
# or a user/org site (username.github.io). Use "/repo-name" for a project site.
PUBLIC_BASE_PATH=

# Public Cal.com booking URL (frontend-safe)
PUBLIC_CAL_URL=

# Public Stripe checkout or payment page URL (frontend-safe)
PUBLIC_STRIPE_URL=

# Stripe — publishable keys may be public; secret keys must never ship to the browser
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (server-side only)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Newsletter / email marketing (server-side only unless a public form embed URL)
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
NEWSLETTER_AUDIENCE_ID=
PUBLIC_NEWSLETTER_EMBED_URL=

# Analytics
PUBLIC_ANALYTICS_ID=

# Serverless forms (endpoint may be public; signing secrets must stay server-side)
PUBLIC_FORM_ENDPOINT=
FORM_SECRET=
